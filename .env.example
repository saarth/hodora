# Supabase project configuration (public values are fine here)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Only needed when self-hosting (Docker/Unraid — see docker-compose.yml).
# Bypasses RLS: set this as a real secret (container env var), never as a
# Docker build arg, and never with a VITE_ prefix. Cloudflare Workers
# deployments set this as a Worker secret instead — see README.md.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed if you're running the optional `cloudflared` service in
# docker-compose.yml. Get this from the Cloudflare Zero Trust dashboard:
# Networks -> Tunnels -> Create a tunnel -> Cloudflared -> the install
# command it shows you has a --token value, copy just that value here.
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# Only needed if you want the "Connections" feature (Settings -> Connections)
# for syncing routes to a cloud storage account, e.g. Nextcloud. Encrypts
# connection credentials before they're stored. Generate with:
#   openssl rand -base64 32
# Set this as a real secret, never as a Docker build arg or VITE_-prefixed
# variable. Rotating it invalidates every already-stored connection, forcing
# users to reconnect. Cloudflare Workers deployments set this as a Worker
# secret instead — see README.md.
TOKEN_ENCRYPTION_KEY=generate-a-32-byte-base64-key

# Only needed if you want the Google Drive connection under Settings ->
# Connections. Create an OAuth 2.0 Client ID (type "Web application") in the
# Google Cloud Console, add https://your-domain/api/cloud/google-drive/callback
# as an authorized redirect URI, and enable the Google Drive API for the
# project. See README.md for the full walkthrough.
GOOGLE_DRIVE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-google-oauth-client-secret

# Only needed if you want the OneDrive connection under Settings ->
# Connections. Register an app in the Azure Portal (App registrations),
# add https://your-domain/api/cloud/onedrive/callback as a "Web" redirect
# URI, and create a client secret under Certificates & secrets. See
# README.md for the full walkthrough.
ONEDRIVE_CLIENT_ID=your-onedrive-application-client-id
ONEDRIVE_CLIENT_SECRET=your-onedrive-client-secret

# Optional. Route planning (Plan a route, and the "rejoin the route" guide
# during navigation) calls the free public BRouter server by default — no
# key needed. If you're self-hosting BRouter (or a BRouter-compatible
# server) yourself, point this at it instead. Must be a client-visible
# VITE_-prefixed variable since routing requests are made from the browser.
VITE_BROUTER_URL=https://brouter.de/brouter

# Optional. Set this to swap the default CARTO raster basemap for a custom
# cycling-focused MapLibre vector style (src/lib/cycling-style.ts) rendered
# from MapTiler's vector tiles. Get a free API key at
# https://cloud.maptiler.com/account/keys/. Leave unset to keep the raster
# basemap — no account needed.
VITE_MAPTILER_KEY=your-maptiler-api-key
