# Supabase project configuration (public values are fine here)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Only needed when self-hosting (Docker/Unraid — see docker-compose.yml).
# Bypasses RLS: set this as a real secret (container env var), never as a
# Docker build arg, and never with a VITE_ prefix. Cloudflare Workers
# deployments set this as a Worker secret instead — see README.md.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only needed if you're running the optional `cloudflared` service in
# docker-compose.yml. Get this from the Cloudflare Zero Trust dashboard:
# Networks -> Tunnels -> Create a tunnel -> Cloudflared -> the install
# command it shows you has a --token value, copy just that value here.
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# Only needed if you want the "Connections" feature (Settings -> Connections)
# for syncing routes to a cloud storage account, e.g. Nextcloud. Encrypts
# connection credentials before they're stored. Generate with:
#   openssl rand -base64 32
# Set this as a real secret, never as a Docker build arg or VITE_-prefixed
# variable. Rotating it invalidates every already-stored connection, forcing
# users to reconnect. Cloudflare Workers deployments set this as a Worker
# secret instead — see README.md.
TOKEN_ENCRYPTION_KEY=generate-a-32-byte-base64-key
