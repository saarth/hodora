# Copy this to cloudflared/config.yml and fill in your own values (both
# config.yml and *.json in this directory are gitignored — the credentials
# file is a private key, don't commit it).
#
# Get the tunnel ID and credentials file by running, on any machine with
# cloudflared installed (doesn't have to be the server itself):
#   cloudflared tunnel login
#   cloudflared tunnel create hodora
#   cloudflared tunnel route dns hodora hodora.yourdomain.com
# That writes <tunnel-id>.json — copy it into this cloudflared/ directory.

tunnel: hodora
credentials-file: /etc/cloudflared/<tunnel-id>.json

ingress:
  # "hodora" below is the docker-compose service name, not localhost — the
  # cloudflared and hodora containers share the compose network and resolve
  # each other by service name. Port 3000 matches the Dockerfile's EXPOSE.
  - hostname: hodora.yourdomain.com
    service: http://hodora:3000
  # Required catch-all — cloudflared rejects a config without one.
  - service: http_status:404
