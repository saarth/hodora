# Copy this file to secrets.properties (gitignored, never committed) and
# fill in your Supabase project's public values — the same ones the web app
# reads from .env (see .env.example at the repo root):
#   VITE_SUPABASE_URL          -> SUPABASE_URL
#   VITE_SUPABASE_PUBLISHABLE_KEY -> SUPABASE_ANON_KEY
#
# The anon/publishable key is safe to ship inside an APK — it's a public
# key by design. Row Level Security on the Supabase side (see
# supabase/migrations/ at the repo root) is what actually scopes each
# rider to their own rows, exactly as it does for the web client. Never put
# the service-role key here; the app never needs it (account deletion and
# cloud-sync OAuth stay server-side, see docs/NATIVE_ANDROID_PLAN.md).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
